DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sim_armada
JWT_SECRET_KEY=your_super_secret_jwt_key_here
CORS_ORIGINS=["*"]

# ==========================================
# KONFIGURASI WHATSAPP GATEWAY (SIAGA DAMKAR)
# ==========================================
WA_ENABLED=true
# Pilihan provider: fonnte / evolution / generic
WA_PROVIDER=fonnte

# Token API dari akun Fonnte (https://fonnte.com) atau Evolution API
WA_API_TOKEN=your_whatsapp_gateway_token_here

# URL endpoint (default fonnte: https://api.fonnte.com/send)
WA_API_URL=https://api.fonnte.com/send

# Target Grup WhatsApp Siaga Damkar (ID Grup atau Nomor HP Admin/Peleton)
# Contoh Group ID di Fonnte: 120363023456789@g.us
# Contoh Nomor HP: 081234567890
WA_SIAGA_TARGET=
